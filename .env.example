# Variables de entorno para Lab Academy (Supabase)
# Copia este archivo como .env.local en desarrollo local,
# o configura estas dos variables en Vercel -> Settings -> Environment Variables.
# NUNCA uses la clave service_role en el frontend.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_publica_anon_key
